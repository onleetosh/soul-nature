# Comma-separated JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL connection string (SQLAlchemy URL, psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://soul:soul@localhost:5432/soul_nature

# Pricing / shipping (amounts in cents)
CURRENCY=usd
SHIPPING_FLAT_CENTS=695
FREE_SHIPPING_THRESHOLD_CENTS=7500

# Public URL of the Next.js storefront (used for Stripe success/cancel redirects)
FRONTEND_URL=http://localhost:3000

# Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:8000/api/stripe/webhook` or the dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Shared secret for the admin API (sent as `Authorization: Bearer <token>`).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me
